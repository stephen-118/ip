<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="620.0" styleClass="main-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="stephen.gui.MainWindow">
    <top>
        <Label styleClass="app-title" text="Stephen" BorderPane.alignment="CENTER_LEFT">
            <BorderPane.margin>
                <Insets bottom="12.0" left="18.0" right="18.0" top="14.0" />
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" styleClass="chat-scroll">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="5.0" styleClass="input-panel">
            <Label fx:id="feedbackLabel" minHeight="18.0" styleClass="feedback-label" />
            <HBox alignment="BOTTOM_CENTER" spacing="10.0">
                <TextArea fx:id="userInput" prefRowCount="2" promptText="Enter a command..."
                          wrapText="true" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" defaultButton="true" onAction="#handleUserInput"
                        text="Send" />
            </HBox>
            <Label styleClass="input-hint" text="Enter to send • Shift+Enter for a new line" />
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="8.0" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>
